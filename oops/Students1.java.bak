class Students1
{
	int id;
	String name;
	int age;
	public void details(){
		System.out.println("id is : "+id);
		System.out.println("name is: "+name);
		System.out.println("age is: "+age);
		System.out.println("-----------------------");
	}
	Students1(int id){
		this.id=id;
	}
	Students1(int id,String name){
		this(id);
		this.name=name;
	}
	Students1(int id,String name,int age){
		this(id,name);
		this.age=age;
	}
	Students1(String name,int id,int age){
		this(id,name,age);
	}
	public static void main(String[] args) 
	{
		Students1 s1=new Students1(101);
		s1.details();
		Students1 s2=new Students1(325,"shakila");
		s2.details();
		Students1 s3=new Students1(57,"laila",24);
		s3.details();
		Students1 s4=new Students1("hani",234,21);
		s4.details();
	}
}
