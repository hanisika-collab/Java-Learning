class Student 
{
	int id;
	String name;
	int age;
	public void details(){
		System.out.println("id is : "+id);
		System.out.println("name is: "+name);
		System.out.println("age is: "+age);
		System.out.println("-----------------------")
	}
	
	Student(int id,String name,int age){
		this.id=id;
		this.name=name;
		this.age=age;
	}
	public static void main(String[] args) 
	{
		Student s1=new Student(101,"smith",22);
		s1.details();
		Student s2=new Student(325,"shakila",23);
		s2.details();
		Student s3=new Student(57,"laila",24);
		s3.details();
		
	}
}
