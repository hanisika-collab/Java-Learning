import java.util.Scanner;
class Smallest4 
{
	public static int smallest4(int a,int b,int c,int d){
		if(a<b && a<c && a<d)
			return a;
		else if(b<c && b<d)
			return b;
		else if(c<d)
			return c;
		else
			return d;
	}
	public static void main(String[] args) 
	{
		Scanner s=new Scanner(System.in);
		System.out.println("enter  3 numbers");
		int a=s.nextInt(),b=s.nextInt(),c=s.nextInt(),d=s.nextInt();
	    int res=smallest4(a,b,c,d);
		System.out.println("the Smallest  of 4 numbers "+res);
	}
}
